# ── Compiled binaries (user builds these themselves) ──────
*.exe
*.obj
*.sys
*.pdb
*.ilk
*.exp

# ── Keep: custom OLLVM clang (not rebuildable from source) ─
!compiler/build/Release/bin/clang.exe
!compiler/build/Release/bin/clang++.exe
!jocky-framework/compiler/build/Release/bin/clang.exe
!jocky-framework/compiler/build/Release/bin/clang++.exe

# ── Keep: PE template + nostdlib runtime ──────────────────
!compiler/jocky/runtime/runtime.obj
!jocky-framework/compiler/jocky/runtime/runtime.obj

# ── Generated artifacts ───────────────────────────────────
bundle.bin

# ── Secrets ───────────────────────────────────────────────
.env
!.env.example
!*/.env.example
!**/.env.example

# ── Python ────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo

# ── Build server runtime data ─────────────────────────────
jocky-framework/server/data/
jocky-framework/server/jocky.db
jocky-framework/server_log.txt

# ── CMake build trees ─────────────────────────────────────
build/
**/CMakeFiles/
**/CMakeCache.txt
**/.cmake/

# ── Node / frontend ───────────────────────────────────────
node_modules/
c2-client/frontend/dist/
jocky-framework/client/dist/

# ── IDE ───────────────────────────────────────────────────
.vscode/
*.vcxproj.user

# ── Logs ──────────────────────────────────────────────────
*.log
stager_debug.log

# ── Generated launcher scripts (install.ps1 writes these) ─
jocky-cli.ps1
jocky-server.ps1
